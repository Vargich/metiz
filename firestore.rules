rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // Admin check: Verify isAdmin boolean in user profile
    function isAdmin() { 
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true; 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- ENTITY VALIDATORS ---
    
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'isAdmin'])
        && data.uid == request.auth.uid
        && data.email is string
        && data.isAdmin is bool;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'category', 'image'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0
        && data.category is string
        && data.image is string;
    }

    // --- MATCH BLOCKS ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Prevent users from making themselves admins
        incoming().isAdmin == existing().isAdmin
      );
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && (request.method == 'delete' || isValidProduct(incoming()));
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
    }
  }
}
